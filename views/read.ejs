<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Users</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="h-full bg-zinc-900 p-10 text-white">
        <div class="nav mb-10">  
            <a class="text-blue-500 hover:text-blue-700 ml-3" href="/">Create User</a>
        <h1 class="text-3xl tracking-tighter mb-3">All Users</h1>
        <div class="bg-zinc-800 rounded-xl p-6 mt-4">
            <p class="text-lg">This is the read page. Your data will appear here.</p>
        </div>
        <div class="user flex gap-3 flex-wrap mt-4">
            <% if (users && users.length) { %>
                <% users.forEach(function(user) { %>
                    <div class="user max-w-72 p-4 mt-2 bg-zinc-800 rounded-lg">
                        <div class="w-full h-52 rounded-lg bg-red-500 overflow-hidden">
                            <img class="w-full h-full object-cover rounded-lg" src="<%= user.image %>" alt="<%= user.name %>">
                        </div>
                        <h3 class="text-xl font-bold mt-2"><%= user.name %></h3>
                        <h5 class="text-md text-gray-400"><%= user.email %></h5>
                        <div class="flex gap-3 mt-3">
                            <a class="text-blue-500 hover:text-blue-700" href="">Edit User</a>
                            <a class="text-red-500 hover:text-red-700" href="/delete/<%= user._id %>">Delete User</a>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="w-full p-6 bg-zinc-800 rounded-xl">
                    <p class="text-lg text-gray-300">No users found yet.</p>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>